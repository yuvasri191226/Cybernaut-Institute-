# Cybernaut Institute of Technology - Backend Environment Configuration
# Copy this file to .env before running: cp .env.example .env

# MySQL 8.0+ Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=college_announcements_db
DB_CHARSET=utf8mb4

# Security & Authentication (JWT)
SECRET_KEY=cybernaut-cit-secret-key-2026-production-key
JWT_SECRET_KEY=cybernaut-cit-jwt-key-2026-production-key
JWT_EXPIRATION_HOURS=24

# Server Configuration
PORT=5000
FLASK_DEBUG=True
CORS_ORIGINS=*

# AI Service Keys (Optional - deterministic NLP fallback is active if omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=
